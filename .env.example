# ============================================================
#  FactuScan Environment Variables
#  Copy this file to `.env` and fill in your real values.
#  NEVER commit the real `.env` file to the repository.
# ============================================================

# --- Google OAuth (Google Cloud Console -> Credentials -> OAuth 2.0 Client IDs) ---
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# --- Google Gemini AI API Key ---
GOOGLE_API_KEY=your-google-gemini-api-key

# --- OCR.Space API Key (optional fallback OCR) ---
OCR_SPACE_API_KEY=your-ocr-space-api-key

# --- Z.AI / BigModel API Key (optional) ---
Z_AI_API_KEY=your-zai-api-key

# --- Flask ---
SECRET_KEY=change-me-to-a-long-random-secret-string
PORT=5000

# --- Database (MySQL) ---
# If you leave these as defaults, the app will fall back to local SQLite.
DB_HOST=localhost
DB_PORT=3306
DB_USER=factuscan_user
DB_PASSWORD=your-db-password
DB_NAME=factuscan
# Optional full URL, overrides the individual DB_* vars if set:
MYSQL_URL=

# --- Email / SMTP (for account confirmation & welcome emails) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your-email@gmail.com
MAIL_PASSWORD=your-google-app-password
